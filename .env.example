# ============================================================
# AlphaSignal — Variables d'environnement
# COPIER CE FICHIER en .env et remplir les valeurs
# NE JAMAIS committer le fichier .env sur Git
# ============================================================

# --- Email (Gmail recommandé) ---
# Créer un mot de passe d'application Gmail :
# Google Account > Sécurité > Validation en 2 étapes > Mots de passe des applications
EMAIL_SENDER=votre.email@gmail.com
EMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
EMAIL_RECIPIENT=votre.email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Clés API optionnelles (free tier — laisser vide si non disponible) ---
# NewsAPI : https://newsapi.org (gratuit, 100 req/jour)
NEWSAPI_KEY=

# Alpha Vantage : https://www.alphavantage.co (gratuit, 25 req/jour)
ALPHA_VANTAGE_KEY=

# --- Capital & Risk Management ---
CAPITAL=1000
RISK_PER_TRADE_PCT=50
# Seuil d'arrêt d'urgence : l'agent suspend les signaux si capital < ce montant
CAPITAL_STOP_THRESHOLD=700

# --- Alertes ---
# Niveau de confiance minimum pour envoyer une alerte email immédiate (1-10)
ALERT_CONFIDENCE_THRESHOLD=8
# Fear & Greed Index : alertes quand l'index sort de la zone normale
FEAR_GREED_EXTREME_LOW=20
FEAR_GREED_EXTREME_HIGH=80

# --- LLM (fallback Groq, voir utils/llm.py) ---
# Modèle utilisé quand Gemini échoue. Groq retire régulièrement ses modèles
# (llama-3.3-70b-versatile puis compound-mini) : à changer ici si le modèle
# par défaut est à son tour déprécié, sans toucher au code.
# GROQ_MODEL=openai/gpt-oss-120b

# --- Dashboard ---
# Adresse d'écoute du dashboard Flask. 127.0.0.1 (défaut) : seul ce PC y
# accède ; le téléphone passe par Tailscale Serve (scripts/setup_tailscale.py).
# 0.0.0.0 rouvre l'accès à tout le réseau local — déconseillé : le dashboard
# n'a pas d'authentification.
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8080

# --- Audit du chat (Phase 4) ---
# Conservation de la table message_audit, en jours. Purge par le cycle
# cleanup (dimanche 3h). 0 ou moins : aucune purge.
# AUDIT_RETENTION_DAYS=90

# --- Audit métacognitif Gemini (Phase 4 / Q1) ---
# Un appel Gemini par décision non-HOLD des cycles ; son résultat n'est lu
# par aucun code. Désactivé par défaut (économise le quota de 20 req/jour).
# METACOG_AUDIT_ENABLED=false

# --- Pipeline groupé : mode Prudent (Phase 4 / Q2) ---
# Le pipeline tourne une fois par actif, action et jour (cache). Sans résultat
# en cache et pipeline en échec : taille × PIPELINE_FALLBACK_FACTOR (0 à 1).
# Alerte (heartbeat, rapport quotidien) au-delà de PIPELINE_FALLBACK_ALERT
# couples (ticker, action) distincts en fallback dans la journée.
# PIPELINE_FALLBACK_FACTOR=0.5
# PIPELINE_FALLBACK_ALERT=5

# --- Réserve Gemini (Phase 4 / Q4) ---
# Appelants qui tentent Gemini (20 requêtes/jour) avant Groq, séparés par des
# virgules. Les autres (pipeline, conseiller_reel…) passent directement par
# Groq, sans jamais tenter Gemini. Valeur vide = aucun appelant.
# GEMINI_RESERVE_POUR=chat,narratif_quotidien,narratif_hebdo
# 429 Gemini « par minute » (Q5) : une seule nouvelle tentative si Google
# demande d'attendre au plus ce nombre de secondes (retryDelay) ; au-delà,
# pas d'attente : repli direct sur Groq pour les appelants qui en ont un.
# GEMINI_RETRY_MAX_SEC=10

# --- P&L latent du chat (Phase 4, TODO §8) ---
# Le chat valorise les positions paper au dernier prix relevé par les cycles
# (data/cache/dernier_prix/), sans appel réseau. Au-delà de cet âge (minutes),
# le prix est considéré comme inconnu : « non disponible ».
# CHAT_PRIX_AGE_MAX_MIN=30

# --- Rapport quotidien ---
# Format HH:MM — heure de Lisbonne (UTC+0 hiver, UTC+1 été)
REPORT_TIME=07:30
TIMEZONE=Europe/Lisbon
