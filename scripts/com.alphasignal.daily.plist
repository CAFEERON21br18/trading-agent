<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphasignal.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/ruby-rosa/trading-agent/scripts/run_mac.sh</string>
        <string>daily</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ruby-rosa/trading-agent</string>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>7</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>12</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/ruby-rosa/trading-agent/logs/launchd_daily.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/ruby-rosa/trading-agent/logs/launchd_daily.log</string>

    <key>RunAtLoad</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/ruby-rosa/miniconda3/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
