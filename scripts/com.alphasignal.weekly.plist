<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphasignal.weekly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/ruby-rosa/trading-agent/scripts/run_mac.sh</string>
        <string>weekly</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ruby-rosa/trading-agent</string>

    <!-- Dimanche à 20h00 (Weekday=0 = dimanche dans launchd) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>20</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/ruby-rosa/trading-agent/logs/launchd_weekly.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ruby-rosa/trading-agent/logs/launchd_weekly.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
