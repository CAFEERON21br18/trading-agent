<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alphasignal.critical</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/ruby-rosa/trading-agent/scripts/run_mac.sh</string>
        <string>critical</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ruby-rosa/trading-agent</string>

    <!-- Toutes les 5 minutes, 24/7 -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>/Users/ruby-rosa/trading-agent/logs/launchd_critical.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ruby-rosa/trading-agent/logs/launchd_critical.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
