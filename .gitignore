# ============================================================
# AlphaSignal — .gitignore
# ============================================================

# Fichier de secrets — NE JAMAIS committer
.env

# Base de données locale
# Dépôt public : aucune base SQLite versionnée, quels que soient son nom et son
# dossier (database.db, registre.db, copies, sauvegardes…), ni ses fichiers WAL
*.db
*-wal
*-shm
data/database.db
data/market_data/
data/indicators/

# v4 : fichiers d'état tournants (regénérés à chaque cycle)
data/cache/
data/heartbeat.json
data/explorer_queue.json
data/lockin_assets.json
data/database.db-shm
data/database.db-wal
# Fichiers d'état écrits en production, hors du suivi git (dépôt public) : compteur NewsAPI du
# rapport (agents/report_sections.py), état de la surveillance du dashboard
# (scripts/surveiller_dashboard.py), copies de la base avant migration ou marquage, qui contiennent
# le portefeuille réel (scripts/marquer_boucles.py)
data/rapport_newsapi.json
data/surveillance_dashboard.json
data/sauvegardes/
# Watchlist modifiée depuis le dashboard : hors du suivi git. Son modèle data/watchlist.json.exemple
# reste suivi, copié au premier lancement si le fichier manque (config.py, utils/helpers.py)
data/watchlist.json

# CSV d'étiquetage du contrôle des chiffres du chat (scripts/rapport_verif_chiffres.py --passe) :
# extraits des réponses, issus de prompts qui contiennent le portefeuille réel
data/verif_chiffres/

# Banc de rejeu du chat (scripts/chat_cas_export.py, scripts/rejouer_chat.py) : cas, résultats,
# copie jetable de la base ; prompts et réponses contiennent le portefeuille réel
data/chat_cas/

# Emails fallback non envoyés
reports/unsent/

# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Claude Code (interne)
.claude/

# Logs
logs/
*.log

# Rapports générés (quotidiens, hebdomadaires, emails non envoyés) : écrits en production,
# hors du suivi git (dépôt public)
reports/

# Fichier de verrouillage npm vide, sans package.json : aucun outil du dépôt ne s'en sert
package-lock.json

# Résultats de backtest (volumieux)
strategies/backtest_results/*.png
strategies/backtest_results/*.html

# Graphify (carte du code) : tout est régénérable sans LLM (graphify extract . --code-only),
# et manifest.json / .graphify_root sont propres à la machine
graphify-out/

# memory/ : fichiers écrits par les cycles en production (TODO §39), hors du suivi git (dépôt
# public). Leurs modèles memory/<nom>.md.exemple restent suivis (utils/memoire_modeles.py).
memory/intuition_log.md
memory/lessons_learned.md
memory/market_patterns.md
memory/metacognition_log.md
memory/performance_tracker.md
memory/trade_journal.md

# Relevés de compte (CSV Revolut) : données réelles, jamais dans le dépôt (règle 9).
# La page « Mes trades » les lit en mémoire ; aucun CSV n'est suivi par git.
*.csv

# Rejeu sur plusieurs années (rejeu/, registre §10) : barres en cache, bases jetables de l'agent,
# grand livre du rejeu, résultats. Régénérés par scripts/rejeu_donnees.py et scripts/rejeu.py.
data/rejeu/
