# ============================================================
# AlphaSignal — .gitignore
# ============================================================

# Fichier de secrets — NE JAMAIS committer
.env

# Base de données locale
# Dépôt public : aucune base SQLite versionnée, quels que soient son nom et son
# dossier (database.db, registre.db, copies, sauvegardes…), ni ses fichiers WAL
*.db
*-wal
*-shm
data/database.db
data/market_data/
data/indicators/

# v4 : fichiers d'état tournants (regénérés à chaque cycle)
data/cache/
data/heartbeat.json
data/explorer_queue.json
data/lockin_assets.json
data/database.db-shm
data/database.db-wal

# CSV d'étiquetage du contrôle des chiffres du chat (scripts/rapport_verif_chiffres.py --passe) :
# extraits des réponses, issus de prompts qui contiennent le portefeuille réel
data/verif_chiffres/

# Emails fallback non envoyés
reports/unsent/

# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Claude Code (interne)
.claude/

# Logs
logs/
*.log

# Rapports générés (optionnel — commenter si tu veux les versionner)
# reports/

# Résultats de backtest (volumieux)
strategies/backtest_results/*.png
strategies/backtest_results/*.html

# Graphify (carte du code) : tout est régénérable sans LLM (graphify extract . --code-only),
# et manifest.json / .graphify_root sont propres à la machine
graphify-out/
